@inherits SynchronizationManagerBase

<div class="sync-manager">
    @if (!string.IsNullOrWhiteSpace(this.Message))
    {
        <p class="sync-manager-error">@this.Message</p>
    }

    <Accordion Panes="this.Panes" AutoClose="true">
        <PaneContent Context="paneValue">
            @{
                SynchronizationStep step = (SynchronizationStep)paneValue;
            }

            @if (step.Status == TrancheStatus.Pending)
            {
                @if (string.IsNullOrWhiteSpace(step.Tranche.VectorStoreId))
                {
                    <Spinner @ref="this.VectorStoreSpinner">
                        <button class="tranche-action-button" disabled="@this.IsBusy" @onclick="this.CreateVectorStoreAsync">Create Vector Store</button>
                    </Spinner>
                }
                else
                {
                    <p class="sync-manager-success">@string.Format(FSPKConstants.Blazor.Synchronization.VectorStoreFormat, step.Tranche.VectorStoreId)</p>
                }
            }
            else if (step.Status == TrancheStatus.VectorStoreCreated)
            {
                <UploadingStatus Tranche="step.Tranche" IsBusy="this.IsBusy" @bind-FilePrefix="this.FilePrefix" UploadRequested="this.UploadFilesAsync" Updated="this.Updated" />
            }
            else if (step.Status == TrancheStatus.FilesUploaded)
            {
                <IndexingStatus Tranche="step.Tranche" IsBusy="this.IsBusy" IndexRequested="this.IndexFilesAsync" Updated="this.Updated" />
            }
            else
            {
                <Spinner @ref="this.ResetFilesSpinner">
                    <Modal Width="0.3" AutoClose="false" IsNested="true" Affirmed="this.ResetFilesAsync">
                        <ClosedContent Context="openCallback">
                            <button class="tranche-delete-button" disabled="@this.IsBusy" @onclick="openCallback">Reset</button>
                        </ClosedContent>
                        <HeaderContent>
                            <h2>Are you sure?</h2>
                        </HeaderContent>
                        <MainContent>
                            <p>Are you sure you want to reset the files indexed for "@step.Tranche.Name"?</p>
                        </MainContent>
                        <FooterContent Context="callbacks">
                            <div class="modal-footer-buttons">
                                <button class="modal-button modal-button-ok" @onclick="callbacks.OnOk">Yes</button>
                                <button class="modal-button modal-button-cancel" @onclick="callbacks.OnCancel">No</button>
                            </div>
                        </FooterContent>
                    </Modal>
                </Spinner>
            }
        </PaneContent>
    </Accordion>
</div>
