@inherits MasterPageBase

<AuthorizeView Context="authenticationContext">
    <Authorized>
        <div class="master-page-header">
            <h1>
                @authenticationContext.User.Identity.Name
            </h1>
            <button class="logout-button" @onclick="this.Logout">Log Out</button>
        </div>

        <nav>
            <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="create-tranche">Create Tranche</NavLink>
        </nav>
    </Authorized>
</AuthorizeView>

<div>
    @this.Body
</div>
